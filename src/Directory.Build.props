<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- LTS releases only -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Symbols are embedded in the assembly rather than shipped as a separate .snupkg:
      GitHub Packages has no symbol-package endpoint and rejects the upload.
    -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>1591</NoWarn>
    <DocumentationFile>Properties\$(MSBuildProjectName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Upstream attribution: this is a fork of nazar-kuzo/azure-functions-worker. -->
    <Authors>Nazar Kuzo</Authors>
    <Copyright>All rights reserved</Copyright>
    <!--
      Repository metadata must point at the fork, not upstream. GitHub Packages resolves the
      owner from the nuspec repository URL and rejects the push when it does not match the
      feed namespace, so pointing this at nazar-kuzo would fail every publish.
    -->
    <PackageProjectUrl>https://github.com/idun-corp/azure-functions-worker</PackageProjectUrl>
    <PackageIconUrl />
    <RepositoryUrl>https://github.com/idun-corp/azure-functions-worker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Azure Functions Worker Isolated AspNetCore MVC ModelBinding Middleware</PackageTags>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Matches the LICENSE file at the repository root; this previously claimed Apache-2.0. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>3.1.2</Version>
    <!--
      Deliberately NOT bumped alongside Version. AppConfiguration bakes this into an
      ExtensionInformationAttribute, and the Functions Worker SDK generates an inner project that
      restores AppConfiguration.Host at exactly this version from a feed. A bump therefore breaks
      the Functions-app projects in this solution before the build that would publish the new Host
      package, so it can never self-publish. Bumping it requires a deliberate two-step release.
    -->
    <AppConfigurationHostVersion>2.2.2</AppConfigurationHostVersion>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <PackageReleaseNotes>
      - Corrected an unresolved XML documentation reference in AzureFunctions.Worker.Extensions.AspNetCore
      - No API or behaviour change otherwise; the build reports zero warnings, and warnings are errors
        from this version on
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>
  
  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.ComponentModel.DataAnnotations" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Serialization" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Options" />
  </ItemGroup>
</Project>