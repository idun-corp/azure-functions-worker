<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!--
		Private packages come from GitHub Packages. Restoring them needs a classic PAT with
		read:packages - credentials go in the user-level config, never here.
		Setup: https://github.com/idun-corp/shared-packages/blob/main/docs/nuget-migration.md
	-->
	<packageSources>
		<clear />
		<add key="github" value="https://nuget.pkg.github.com/idun-corp/index.json" />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>
	<!-- Mapping keeps public-package lookups off the private feed, which 403s on them. -->
	<packageSourceMapping>
		<packageSource key="github">
			<package pattern="Idun.*" />
			<package pattern="AzureFunctions.Worker.Extensions.*" />
			<package pattern="DurableTask.Client.AzureStorage" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
