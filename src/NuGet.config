<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!--
		Credentials never belong in this file. CI injects them into its own copy of it, and
		developers store theirs in the user-level config (~/.nuget/NuGet/NuGet.Config).
		See docs/nuget-migration.md in the shared-packages repository.
	-->
	<packageSources>
		<!-- clear so a clean CI runner and a developer machine see the same source list -->
		<clear />
		<add key="github" value="https://nuget.pkg.github.com/idun-corp/index.json" />
		<add key="idun-corp" value="https://pkgs.dev.azure.com/idun-corp/_packaging/idun-corp/nuget/v3/index.json" />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>
	<!--
		Mapping is required, not cosmetic: without it NuGet queries every source for every package
		and the private feeds answer with intermittent 403s for public packages.

		Both private sources carry the same patterns during the migration. Versions published before
		the move to GitHub Packages exist only on idun-corp, newer ones only on github, and NuGet
		queries both. Drop idun-corp once nothing references a version that predates the move.
	-->
	<packageSourceMapping>
		<packageSource key="github">
			<package pattern="Idun.*" />
			<package pattern="AzureFunctions.Worker.Extensions.*" />
			<package pattern="DurableTask.Client.AzureStorage" />
		</packageSource>
		<packageSource key="idun-corp">
			<package pattern="Idun.*" />
			<package pattern="AzureFunctions.Worker.Extensions.*" />
			<package pattern="DurableTask.Client.AzureStorage" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
